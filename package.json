{
  "name": "muvautomation-secure-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "MVP académico: simulación de automatización de incidentes (datos ficticios). Laboratorio 3 — Secure Product Challenge.",
  "workspaces": [
    "app/web-frontend",
    "app/alerts-api",
    "app/audit-service"
  ],
  "scripts": {
