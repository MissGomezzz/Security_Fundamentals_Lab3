# Sistema operativo / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# Variables de entorno locales (nunca subir IP/credenciales reales del entorno del docente)
.env
*.env.local
!.env.example

# Salidas grandes o temporales que no deben versionarse tal cual
# (los PCAP/nmap/zap "oficiales" que sí son evidencia van filtrados y con nombre
#  explícito dentro de evidence/, no aquí; esto es solo para basura temporal)
*.tmp
*.log.bak
/tmp/

# Reportes ZAP en formato de sesión (pesados); conservar solo el export HTML/JSON final
*.zap.session/
*.session

# Capturas de red completas sin filtrar (guardar solo las filtradas dentro de evidence/blue)
*-full.pcap
*-unfiltered.pcap

# Node
node_modules/
npm-debug.log*

# Logs de aplicación (se generan en runtime; evidencia filtrada va a evidence/blue)
logs/*.log
*.log
!evidence/**/*.log

# Python
__pycache__/
*.pyc
